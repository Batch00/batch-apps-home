RESEND_API_KEY=your_resend_api_key_here
# Long random value that signs the Approve and Deny links (openssl rand -hex 32)
APPROVAL_SECRET=your_long_random_secret_here
# Address that receives new access requests
ADMIN_EMAIL=your_admin_email_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# BatchBrain public YTD, read-only as site_reader through the Supabase transaction pooler (port 6543)
YTD_DATABASE_URL=postgresql://site_reader.your_project_ref:your_password@your_pooler_host:6543/postgres
